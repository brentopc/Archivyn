@inherits LayoutComponentBase
@using MudBlazor;

<MudThemeProvider Theme="_currentTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="archivyn-layout">
    <MudDrawer Open="true"
               Fixed="true"
               Anchor="Anchor.Start"
               Elevation="1"
               Variant="DrawerVariant.Responsive"
               Color="Color.Primary"
               Width="260px">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Archivyn</MudText>
        </MudDrawerHeader>
        <MudNavMenu Color="Color.Secondary">
            <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Inherit" Href="/">Dashboard</MudNavLink>
            <MudNavGroup Title="Admin" Expanded="false" Icon="@Icons.Material.Filled.AdminPanelSettings" IconColor="Color.Inherit">
                <MudNavGroup Title="Keywords" Expanded="false" Icon="@Icons.Material.Filled.Key" IconColor="Color.Inherit">
                    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.DataObject" IconColor="Color.Inherit" Href="/admin/keyword-types">Keyword Types</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.DataArray" IconColor="Color.Inherit" Href="/admin/keyword-type-groups">Keyword Groups</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Documents" Expanded="false" Icon="@Icons.Material.Filled.Newspaper" IconColor="Color.Inherit">
                    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.DataObject" IconColor="Color.Inherit" Href="/admin/document-types">Document Types</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.DataArray" IconColor="Color.Inherit" Href="/admin/document-type-groups">Document Type Groups</MudNavLink>
                </MudNavGroup>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _currentTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#8FA31E",
            Secondary = "#556B2F",
            Info = "#EFF5D2",
            Success = "#00FF00",
            Warning = "#FF9900",
            Error = "#FF0000",
            AppbarBackground = "#212121",
            TextPrimary = "#EFF5D2",
            TextSecondary = "#EFF5D2"
        }
    };
}