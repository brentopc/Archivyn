@inherits LayoutComponentBase

@using MudBlazor

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar>
        Archivyn
    </MudAppBar>
    <MudDrawer Open="true">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Dashboard</MudNavLink>
            <MudNavGroup Title="Admin" Expanded="false">
                <MudNavGroup Title="Keywords" Expanded="false">
                    <MudNavLink Href="/keyword-types"  Match="NavLinkMatch.Prefix">Keyword Types</MudNavLink>
                    <MudNavLink Href="/keyword-type-groups"  Match="NavLinkMatch.Prefix">Keyword Groups</MudNavLink>
                </MudNavGroup>
                <MudNavGroup Title="Documents" Expanded="false">
                    <MudNavLink Href="/document-types"  Match="NavLinkMatch.Prefix">Document Types</MudNavLink>
                    <MudNavLink Href="/document-type-groups"  Match="NavLinkMatch.Prefix">Document Type Groups</MudNavLink>
                </MudNavGroup>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        
    </MudMainContent>
</MudLayout>