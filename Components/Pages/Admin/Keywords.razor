@page "/admin/keywords"

@using Archivyn.Data
@using Archivyn.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject ArchivynDbContext Db
@inject IJSRuntime JS

<PageTitle>Keyword Types</PageTitle>

<h1>Keyword Types</h1>

<div class="card p-3 mb-4">
    <div class="mb-3">
        <label class="form-label" for="keyword-name">
            Keyword Name
        </label>

        <input id="keyword-name"
               class="form-control"
               @bind="NewKeyword.KeyTypeName" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="keyword-length">
            Length
        </label>

        <input id="keyword-length"
               class="form-control"
               type="number"
               min="1"
               @bind="NewKeyword.KeyTypeLen" />
    </div>

    <div>
        <button type="button"
                class="btn btn-primary"
                disabled="@IsBusy"
                @onclick="CreateKeywordAsync">
            @(IsBusy ? "Creating..." : "Create Keyword")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="alert @StatusCssClass mt-3 mb-0">
            @StatusMessage
        </div>
    }
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Keyword</th>
            <th>Length</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (KeywordList.Count == 0)
        {
            <tr>
                <td colspan="4">No keyword types have been created.</td>
            </tr>
        }
        else
        {
            @foreach (var keyword in KeywordList)
            {
                <tr>
                    <td>@keyword.KeyTypeNum</td>
                    <td>@keyword.KeyTypeName</td>
                    <td>@keyword.KeyTypeLen</td>
                    <td class="text-end">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger"
                                disabled="@IsBusy"
                                @onclick="() => DeleteKeywordAsync(keyword)">
                            @(IsBusy ? "Deleting..." : "Delete")
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<KeyType> KeywordList = [];
    private KeyType NewKeyword = new();

    private bool IsBusy;
    private string? StatusMessage;
    private string StatusCssClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        await LoadKeywordsAsync();
    }

    private async Task LoadKeywordsAsync()
    {
        KeywordList = await Db.KeyTypes
            .AsNoTracking()
            .OrderBy(keyword => keyword.KeyTypeName)
            .ToListAsync();
    }

    private async Task CreateKeywordAsync()
    {
        Console.WriteLine($"CreateKeywordAsync fired. Keyword name: '{NewKeyword.KeyTypeName}'");


        StatusMessage = null;

        var name = NewKeyword.KeyTypeName?.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            ShowError("Enter a keyword name.");
            return;
        }

        if (NewKeyword.KeyTypeLen <= 0)
        {
            ShowError("Length must be greater than zero.");
            return;
        }

        var normalizedName = name.ToLower();

        var duplicateExists = await Db.KeyTypes
            .AsNoTracking()
            .AnyAsync(keyword =>
                keyword.KeyTypeName.ToLower() == normalizedName);

        if (duplicateExists)
        {
            ShowError($"A keyword type named “{name}” already exists.");
            return;
        }

        IsBusy = true;

        try
        {
            var keyword = new KeyType
            {
                KeyTypeName = name,
                KeyTypeLen = NewKeyword.KeyTypeLen,
                KeyTypeMask = NewKeyword.KeyTypeMask,
                KeyTypeFlags = NewKeyword.KeyTypeFlags,
                DataType = NewKeyword.DataType
            };

            Db.KeyTypes.Add(keyword);
            await Db.SaveChangesAsync();

            NewKeyword = new KeyType();

            await LoadKeywordsAsync();

            StatusCssClass = "alert-success";
            StatusMessage = $"Keyword type “{keyword.KeyTypeName}” was saved.";
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            ShowError($"The keyword could not be saved: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteKeywordAsync(KeyType keyword)
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        var assignedGroups = await Db.KeywordSetKeyTypes
        .AsNoTracking()
        .Where(membership =>
            membership.KeyTypeNum == keyword.KeyTypeNum &&
            membership.KeywordSet.IsKeyTypeGroup == 1)
        .Select(membership =>
            membership.KeywordSet.KeySetName)
        .Distinct()
        .OrderBy(groupName => groupName)
        .ToListAsync();

        if (assignedGroups.Count > 0)
        {
            var groupNames = string.Join(", ", assignedGroups);

            ShowError(
                $"Keyword Type “{keyword.KeyTypeName}” cannot be deleted " +
                $"because it is assigned to the following Keyword Type " +
                $"Group(s): {groupNames}. Remove it from those groups first.");

            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete Keyword Type “{keyword.KeyTypeName}”?");

        if (!confirmed)
        {
            return;
        }

        IsBusy = true;

        try
        {
            var existingKeyword = await Db.KeyTypes
                .SingleOrDefaultAsync(item =>
                    item.KeyTypeNum == keyword.KeyTypeNum);

            if (existingKeyword is null)
            {
                ShowError("The Keyword Type no longer exists.");

                await LoadKeywordsAsync();
                return;
            }

            Db.KeyTypes.Remove(existingKeyword);

            await Db.SaveChangesAsync();

            Db.ChangeTracker.Clear();

            await LoadKeywordsAsync();

            StatusCssClass = "alert-success";
            StatusMessage =
                $"Keyword Type “{keyword.KeyTypeName}” was deleted.";
        }
        catch (DbUpdateException)
        {
            // Fallback protection in case the keyword is assigned
            // after the initial membership check.
            Db.ChangeTracker.Clear();

            ShowError(
                $"Keyword Type “{keyword.KeyTypeName}” cannot be deleted " +
                "because it is currently in use.");

            await LoadKeywordsAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Keyword Type could not be deleted: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ShowError(string message)
    {
        StatusCssClass = "alert-danger";
        StatusMessage = message;
    }

    private int TestClicks;

    private void TestBlazor()
    {
        TestClicks++;
        Console.WriteLine($"Test Blazor clicked: {TestClicks}");
    }
}