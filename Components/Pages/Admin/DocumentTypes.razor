@page "/admin/document-types"

@inherits LayoutComponentBase
@using MudBlazor

@using Archivyn.Data
@using Archivyn.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject ArchivynDbContext Db
@inject IJSRuntime JS

<PageTitle>Document Types</PageTitle>

@if (GroupList.Count == 0)
{
    <MudText class="mb-4" Typo="Typo.h6" Color="Color.Secondary">Create a Document Type Group before creating a Document Type.</MudText>            
}
else
{
    <MudText Typo="Typo.h5">Document Type Name</MudText>
    <MudTextField class="mb-4" @bind-Value="NewDocumentTypeName" Label="" Variant="Variant.Outlined"></MudTextField>

    <MudText Typo="Typo.h5">Document Type Group</MudText>
    <MudSelect class="mb-4" @bind-Value="SelectedGroupNum" Variant="Variant.Outlined" Label="">
        @foreach (var group in GroupList)
        {
            <MudSelectItem Value="@group.ItemTypeGroupNum">@group.ItemTypeGroupName</MudSelectItem>
        }
    </MudSelect>

    <MudButton class="mb-4"
               Variant="Variant.Filled"
               Color="Color.Primary"
               disabled="@IsBusy"
               @onclick="CreateDocumentTypeAsync">
        @(IsBusy ? "Creating..." : "Create Document Type")
    </MudButton>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <MudText class="mb-4" Typo="Typo.h6" Color="Color.Secondary">@StatusMessage</MudText>
    }

    <MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
        <MudPaper Height="400px" Width="100%">
            <MudTable Items="DocumentTypeList" Height="350px" Virtualize="true" FixedHeader="true">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Document Type</MudTh>
                    <MudTh>Document Type Group</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.ItemTypeNum</MudTd>
                    <MudTd DataLabel="Document Type">@context.ItemTypeName</MudTd>
                    <MudTd DataLabel="Document Type Group">@(context.ItemTypeGroup?.ItemTypeGroupName ?? "Unassigned")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Class="mx-2" Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   disabled="@IsBusy"
                                   href="@($"/admin/document-types/{context.ItemTypeNum}/keywords")">
                            Edit Keywords
                        </MudButton>
                        <MudButton Class="mx-2" Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   disabled="@IsBusy"
                                   @onclick="() => DeleteDocumentTypeAsync(context.ItemTypeNum)">
                            @(IsBusy ? "Deleting..." : "Delete")
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudContainer>
}

@code {
    private List<ItemTypeGroup> GroupList = [];

    private List<DocumentType> DocumentTypeList = [];

    private string NewDocumentTypeName = string.Empty;

    private long SelectedGroupNum;

    private bool IsBusy;

    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        GroupList = await Db.ItemTypeGroups
            .AsNoTracking()
            .OrderBy(group =>
                group.ItemTypeGroupName)
            .ToListAsync();

        DocumentTypeList = await Db.DocumentTypes
            .AsNoTracking()
            .Include(documentType =>
                documentType.ItemTypeGroup)
            .OrderBy(documentType =>
                documentType.ItemTypeGroup
                    .ItemTypeGroupName)
            .ThenBy(documentType =>
                documentType.ItemTypeName)
            .ToListAsync();
    }

    private async Task CreateDocumentTypeAsync()
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        var name = NewDocumentTypeName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            ShowError(
                "Enter a Document Type name.");

            return;
        }

        if (name.Length > 66)
        {
            ShowError(
                "The Document Type name cannot exceed 66 characters.");

            return;
        }

        if (SelectedGroupNum <= 0)
        {
            ShowError(
                "Select a Document Type Group.");

            return;
        }

        var groupExists =
            await Db.ItemTypeGroups
                .AsNoTracking()
                .AnyAsync(group =>
                    group.ItemTypeGroupNum
                        == SelectedGroupNum);

        if (!groupExists)
        {
            ShowError(
                "The selected Document Type Group no longer exists.");

            return;
        }

        var normalizedName = name.ToLower();

        var duplicateExists =
            await Db.DocumentTypes
                .AsNoTracking()
                .AnyAsync(documentType =>
                    documentType.ItemTypeName.ToLower()
                        == normalizedName);

        if (duplicateExists)
        {
            ShowError(
                $"A Document Type named “{name}” already exists.");

            return;
        }

        IsBusy = true;

        try
        {
            var documentType = new DocumentType
            {
                ItemTypeName = name,
                ItemTypeGroupNum = SelectedGroupNum,
                AutoNameString = null,
            };

            Db.DocumentTypes.Add(documentType);

            await Db.SaveChangesAsync();

            NewDocumentTypeName = string.Empty;
            SelectedGroupNum = 0;

            Db.ChangeTracker.Clear();

            await LoadPageAsync();
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"A Document Type named “{name}” already exists.");
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Document Type could not be created: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteDocumentTypeAsync(
        long itemTypeNum)
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        var documentType =
            await Db.DocumentTypes
                .AsNoTracking()
                .SingleOrDefaultAsync(item =>
                    item.ItemTypeNum
                        == itemTypeNum);

        if (documentType is null)
        {
            ShowError(
                "The Document Type no longer exists.");

            await LoadPageAsync();
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete Document Type “{documentType.ItemTypeName}”?");

        if (!confirmed)
        {
            return;
        }

        IsBusy = true;

        try
        {
            var trackedDocumentType =
                await Db.DocumentTypes.FindAsync(
                    itemTypeNum);

            if (trackedDocumentType is null)
            {
                ShowError(
                    "The Document Type no longer exists.");

                return;
            }

            Db.DocumentTypes.Remove(
                trackedDocumentType);

            await Db.SaveChangesAsync();

            Db.ChangeTracker.Clear();

            await LoadPageAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Document Type could not be deleted: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ClearStatus()
    {
        StatusMessage = null;
    }

    private void ShowError(string message)
    {
        StatusMessage = message;
    }
}