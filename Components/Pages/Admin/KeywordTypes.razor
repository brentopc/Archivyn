@page "/admin/keyword-types"

@inherits LayoutComponentBase
@using MudBlazor

@using Archivyn.Data
@using Archivyn.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject ArchivynDbContext Db
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudText Typo="Typo.h2" class="mb-4">Keyword Types</MudText>

<MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudPaper Height="400px" Width="100%">
        <MudTable Items="KeywordList" Height="350px" Virtualize="true" FixedHeader="true">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Length</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.KeyTypeNum</MudTd>
                <MudTd DataLabel="Name">@context.KeyTypeName</MudTd>
                <MudTd DataLabel="Length">@context.KeyTypeLen</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Class="mx-2" Variant="Variant.Filled"
                               Color="Color.Primary"
                               disabled="@(
                               IsBusy ||
                               @context.IsSystem)"
                               href="@($"/admin/keyword-types/{context.KeyTypeNum}/properties")">
                        Edit
                    </MudButton>
                    <MudButton Class="mx-2" Variant="Variant.Filled"
                               Color="Color.Secondary"
                               disabled="@(
                               IsBusy ||
                               @context.IsSystem)"
                               @onclick="() => DeleteKeywordAsync(context)">
                        @(IsBusy ? "Deleting..." : "Delete")
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
</MudContainer>

<MudText Typo="Typo.h5">Keyword Name</MudText>
<MudTextField class="mb-4" @bind-Value="NewKeyword.KeyTypeName" Label="" Variant="Variant.Outlined"></MudTextField>

<MudText Typo="Typo.h5">Length</MudText>
<MudTextField class="mb-4" type="number" @bind-Value="NewKeyword.KeyTypeLen" Label="" Variant="Variant.Outlined"></MudTextField>

<MudButton Class="mx-2"
    Variant="Variant.Filled"
    Color="Color.Primary"
    disabled="@IsBusy"
    @onclick="CreateKeywordAsync">
    @(IsBusy ? "Creating..." : "Create Keyword")
</MudButton>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <MudText class="mb-4" Typo="Typo.h6" Color="Color.Warning">@StatusMessage</MudText>
}

@code {
    private List<KeyType> KeywordList = new List<KeyType>();
    private KeyType NewKeyword = new();

    private bool IsBusy;
    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeywordsAsync();
    }

    private async Task LoadKeywordsAsync()
    {
        KeywordList = await Db.KeyTypes
            .AsNoTracking()
            .OrderBy(keyword => keyword.KeyTypeName)
            .ToListAsync();
    }

    private async Task CreateKeywordAsync()
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }
        IsBusy = true;

        try
        {
            Console.WriteLine($"CreateKeywordAsync fired. Keyword name: '{NewKeyword.KeyTypeName}'");

            var name = NewKeyword.KeyTypeName?.Trim();

            if (string.IsNullOrWhiteSpace(name))
            {
                throw new("Enter a keyword name.");
            }

            if (NewKeyword.KeyTypeLen <= 0)
            {
                throw new("Length must be greater than zero.");
            }

            var normalizedName = name.ToLower();

            var duplicateExists = await Db.KeyTypes
                .AsNoTracking()
                .AnyAsync(keyword =>
                    keyword.KeyTypeName.ToLower() == normalizedName);

            if (duplicateExists)
            {
                throw new($"A keyword type named “{name}” already exists.");
            }

            var keyword = new KeyType
            {
                KeyTypeName = name,
                KeyTypeLen = NewKeyword.KeyTypeLen,
                DataType = NewKeyword.DataType
            };

            Db.KeyTypes.Add(keyword);
            await Db.SaveChangesAsync();

            NewKeyword = keyword;

            Navigation.NavigateTo($"/admin/keyword-types/{NewKeyword.KeyTypeNum}/properties");
        }
        catch (Exception ex)
        {
            ShowError(
                $"The Keyword Type Group could not be added: {ex.Message}");
        }
        finally
        {
            Db.ChangeTracker.Clear();

            await LoadKeywordsAsync();

            IsBusy = false;
        }
    }

    private async Task DeleteKeywordAsync(KeyType keyword)
    {
        try
        {
            StatusMessage = null;

            if (IsBusy)
            {
                return;
            }
            IsBusy = true;

            var assignedGroups = await Db.KeywordSetKeyTypes
            .AsNoTracking()
            .Where(membership =>
                membership.KeyTypeNum == keyword.KeyTypeNum &&
                membership.KeywordSet.IsKeyTypeGroup == 1)
            .Select(membership =>
                membership.KeywordSet.KeySetName)
            .Distinct()
            .OrderBy(groupName => groupName)
            .ToListAsync();

            if (assignedGroups.Count > 0)
            {
                var groupNames = string.Join(", ", assignedGroups);

                throw new(
                    $"Keyword Type “{keyword.KeyTypeName}” cannot be deleted " +
                    $"because it is assigned to the following Keyword Type " +
                    $"Group(s): {groupNames}. Remove it from those groups first.");
            }

            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Delete Keyword Type “{keyword.KeyTypeName}”?");

            if (!confirmed)
            {
                return;
            }

            var existingKeyword = await Db.KeyTypes
                .SingleOrDefaultAsync(item =>
                    item.KeyTypeNum == keyword.KeyTypeNum);

            if (existingKeyword is null)
            {
                throw new("The Keyword Type no longer exists.");
            }

            Db.KeyTypes.Remove(existingKeyword);

            await Db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            ShowError(
                $"The Keyword Type Group could not be added: {ex.Message}");
        }
        finally
        {
            Db.ChangeTracker.Clear();

            await LoadKeywordsAsync();

            IsBusy = false;
        }
    }

    private void ShowError(string message)
    {
        StatusMessage = message;
    }
}