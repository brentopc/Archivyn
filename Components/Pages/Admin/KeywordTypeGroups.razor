@page "/admin/keyword-type-groups"

@inherits LayoutComponentBase
@using MudBlazor

@using Archivyn.Data
@using Archivyn.Models
@using Microsoft.EntityFrameworkCore

@inject ArchivynDbContext Db

<PageTitle>Keyword Type Groups</PageTitle>

<MudText Typo="Typo.h5">Keyword Group Name</MudText>
<MudTextField class="mb-4" @bind-Value="NewGroup.KeySetName" Label="" Variant="Variant.Outlined"></MudTextField>
            
<MudButton class="mb-4"
            Variant="Variant.Filled"
            Color="Color.Primary"
            disabled="@IsBusy"
            @onclick="CreateGroupAsync">
    @(IsBusy ? "Creating..." : "Create Keyword Group")
</MudButton>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <MudText class="mb-4" Typo="Typo.h6" Color="Color.Secondary">@StatusMessage</MudText>
}

<MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
    <MudPaper Height="400px" Width="100%">
        <MudTable Items="GroupList" Height="350px" Virtualize="true" FixedHeader="true">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>                
                <MudTd DataLabel="ID">@context.KeySetTableNum</MudTd>
                <MudTd DataLabel="Name">@context.KeySetName</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Class="mx-2" Variant="Variant.Filled"
                               Color="Color.Primary"
                               disabled="@IsBusy"
                               href="@($"/admin/keyword-type-groups/{context.KeySetTableNum}/keywords")">
                        Edit Keywords
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<KeywordSet> GroupList = [];

    private KeywordSet NewGroup = new();

    private bool IsBusy;
    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        GroupList = await Db.KeywordSets
            .AsNoTracking()

            // Hyland value 1 means standard Keyword Type Group.
            // Value 0 would be an AutoFill Keyword Set.
            // Value 2 would be a Multi-Instance Keyword Type Group.
            .Where(group => group.IsKeyTypeGroup == 1)

            .OrderBy(group => group.KeySetName)
            .ToListAsync();
    }

    private async Task CreateGroupAsync()
    {
        Console.WriteLine($"CreateGroupAsync fired. Group name: '{NewGroup.KeySetName}'");

        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        var name = NewGroup.KeySetName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            ShowError(
                "Enter a Keyword Type Group name.");

            return;
        }

        if (name.Length > 80)
        {
            ShowError(
                "The group name cannot exceed 80 characters.");

            return;
        }

        var normalizedName = name.ToLower();

        var duplicateExists = await Db.KeywordSets
            .AsNoTracking()
            .AnyAsync(group =>
                group.IsKeyTypeGroup == 1 &&
                group.KeySetName.ToLower() == normalizedName);

        if (duplicateExists)
        {
            ShowError(
                $"A Keyword Type Group named “{name}” already exists.");

            return;
        }

        IsBusy = true;

        try
        {
            var group = new KeywordSet
            {
                KeySetName = name,

                // This page creates only standard Keyword Type Groups.
                IsKeyTypeGroup = 1,

                Flags = 0
            };

            Db.KeywordSets.Add(group);

            await Db.SaveChangesAsync();

            var newGroupNumber =
                group.KeySetTableNum;

            NewGroup = new KeywordSet();

            Db.ChangeTracker.Clear();

            await LoadGroupsAsync();
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"A Keyword Type Group named “{name}” already exists.");
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Keyword Type Group could not be created: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ShowError(string message)
    {
        StatusMessage = message;
    }
}