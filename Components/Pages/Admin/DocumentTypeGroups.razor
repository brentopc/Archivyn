@page "/admin/document-type-groups"

@inherits LayoutComponentBase
@using MudBlazor

@using Archivyn.Data
@using Archivyn.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop

@inject ArchivynDbContext Db
@inject IJSRuntime JS

<PageTitle>Document Type Groups</PageTitle>

<MudText Typo="Typo.h5">Document Type Name</MudText>
<MudTextField class="mb-4" @bind-Value="NewDocumentTypeGroupName" Label="" Variant="Variant.Outlined"></MudTextField>

<MudButton class="mb-4"
           Variant="Variant.Filled"
           Color="Color.Primary"
           disabled="@IsBusy"
           @onclick="CreateGroupAsync">
    @(IsBusy ? "Creating..." : "Create Document Type Group")
</MudButton>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <MudText class="mb-4" Typo="Typo.h6" Color="Color.Secondary">@StatusMessage</MudText>
}

<MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
    <MudPaper Height="400px" Width="100%">
        <MudTable Items="DocumentTypeGroupList" Height="350px" Virtualize="true" FixedHeader="true">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Document Types</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.ItemTypeGroupNum</MudTd>
                <MudTd DataLabel="Name">@context.ItemTypeGroupName</MudTd>
                <MudTd DataLabel="Document Types">@context.DocumentTypes.Count</MudTd>
                <MudTd DataLabel="Actions">  
                    <MudButton Class="mx-2" Variant="Variant.Filled"
                               Color="Color.Secondary"
                               disabled="@IsBusy"
                               @onclick="() => DeleteGroupAsync(context.ItemTypeGroupNum)">
                        @(IsBusy ? "Deleting..." : "Delete")
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<ItemTypeGroup> DocumentTypeGroupList = [];

    private string NewDocumentTypeGroupName = string.Empty;

    private bool IsBusy;

    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        DocumentTypeGroupList = await Db.ItemTypeGroups
            .AsNoTracking()
            .Include(group => group.DocumentTypes)
            .OrderBy(group => group.ItemTypeGroupName)
            .ToListAsync();
    }

    private async Task CreateGroupAsync()
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        var name = NewDocumentTypeGroupName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            ShowError(
                "Enter a Document Type Group name.");

            return;
        }

        if (name.Length > 66)
        {
            ShowError(
                "The group name cannot exceed 66 characters.");

            return;
        }

        var normalizedName = name.ToLower();

        var duplicateExists = await Db.ItemTypeGroups
            .AsNoTracking()
            .AnyAsync(group =>
                group.ItemTypeGroupName.ToLower()
                    == normalizedName);

        if (duplicateExists)
        {
            ShowError(
                $"A Document Type Group named “{name}” already exists.");

            return;
        }

        IsBusy = true;

        try
        {
            var group = new ItemTypeGroup
            {
                ItemTypeGroupName = name,
                Flags = 0
            };

            Db.ItemTypeGroups.Add(group);

            await Db.SaveChangesAsync();

            NewDocumentTypeGroupName = string.Empty;

            Db.ChangeTracker.Clear();

            await LoadGroupsAsync();
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"A Document Type Group named “{name}” already exists.");
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Document Type Group could not be created: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task DeleteGroupAsync(
        long itemTypeGroupNum)
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        var group = await Db.ItemTypeGroups
            .AsNoTracking()
            .SingleOrDefaultAsync(item =>
                item.ItemTypeGroupNum
                    == itemTypeGroupNum);

        if (group is null)
        {
            ShowError(
                "The Document Type Group no longer exists.");

            await LoadGroupsAsync();
            return;
        }

        var documentTypeCount =
            await Db.DocumentTypes.CountAsync(documentType =>
                documentType.ItemTypeGroupNum
                    == itemTypeGroupNum);

        if (documentTypeCount > 0)
        {
            ShowError(
                $"“{group.ItemTypeGroupName}” cannot be deleted because it contains {documentTypeCount} Document Type(s).");

            return;
        }

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete Document Type Group “{group.ItemTypeGroupName}”?");

        if (!confirmed)
        {
            return;
        }

        IsBusy = true;

        try
        {
            var trackedGroup =
                await Db.ItemTypeGroups.FindAsync(
                    itemTypeGroupNum);

            if (trackedGroup is null)
            {
                ShowError(
                    "The Document Type Group no longer exists.");

                return;
            }

            Db.ItemTypeGroups.Remove(trackedGroup);

            await Db.SaveChangesAsync();

            Db.ChangeTracker.Clear();

            await LoadGroupsAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Document Type Group could not be deleted: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void ShowError(string message)
    {
        StatusMessage = message;
    }
}