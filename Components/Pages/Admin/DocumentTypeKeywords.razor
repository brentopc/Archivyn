@page "/admin/document-types/{ItemTypeNum:long}/keywords"

@inherits LayoutComponentBase
@using MudBlazor

@using Archivyn.Data
@using Archivyn.Models
@using Microsoft.EntityFrameworkCore

@inject ArchivynDbContext Db

<PageTitle>Document Type Keywords</PageTitle>

<MudText class="mb-4" Typo="Typo.h5">@CurrentDocumentType.ItemTypeName #@CurrentDocumentType.ItemTypeNum</MudText>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <MudText class="mb-4" Typo="Typo.h6" Color="Color.Secondary">@StatusMessage</MudText>
}

<MudText class="mb-4" Typo="Typo.h6">Keyword Types</MudText>
<MudGrid>
    <MudItem xs="6">
        <MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
            <MudPaper Height="400px" Width="100%">
                <MudTable Items="AvailableKeywords" Height="350px" Virtualize="true" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.KeyTypeNum</MudTd>
                        <MudTd DataLabel="Name">@context.KeyTypeName</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Class="mx-2" Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       disabled="@IsBusy"
                                       @onclick="() => AddKeywordAsync(context.KeyTypeNum)">
                                Add
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudContainer>
    </MudItem>
    <MudItem xs="6">
        <MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
            <MudPaper Height="400px" Width="100%">
                <MudTable Items="DirectAssignments" Height="350px" Virtualize="true" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.KeyTypeNum</MudTd>
                        <MudTd DataLabel="Name">@context.KeyType.KeyTypeName</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Class="mx-2" Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       disabled="@IsBusy"
                                       @onclick="() => RemoveKeywordAsync(context.KeyTypeNum)">
                                Remove
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudContainer>
    </MudItem>
</MudGrid>

<MudText class="mb-4" Typo="Typo.h6">Keyword Type Groups</MudText>
<MudGrid>
    <MudItem xs="6">
        <MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
            <MudPaper Height="400px" Width="100%">
                <MudTable Items="GroupOptions" Height="350px" Virtualize="true" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.Group.KeySetTableNum</MudTd>
                        <MudTd DataLabel="Name">@context.Group.KeySetName</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Class="mx-2" Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       disabled="@(
                                       IsBusy ||
                                       @context.IsEmpty ||
                                       @context.ConflictingKeywords.Count > 0)"
                                       @onclick="() => AddGroupAsync(context.Group.KeySetTableNum)">
                                Add
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudContainer>
    </MudItem>
    <MudItem xs="6">
        <MudContainer class="mb-4" MaxWidth="MaxWidth.ExtraLarge">
            <MudPaper Height="400px" Width="100%">
                <MudTable Items="GroupAssignments" Height="350px" Virtualize="true" FixedHeader="true">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">@context.KeySetTableNum</MudTd>
                        <MudTd DataLabel="Name">@context.KeywordTypeGroup.KeySetName</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Class="mx-2" Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       disabled="@IsBusy"
                                       @onclick="() => RemoveGroupAsync(context.KeySetTableNum)">
                                Remove
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudContainer>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public long ItemTypeNum { get; set; }

    private DocumentType CurrentDocumentType = new DocumentType();

    private List<DocumentTypeKeyType> DirectAssignments = new List<DocumentTypeKeyType>();

    private List<DocumentTypeKeywordTypeGroup> GroupAssignments = new List<DocumentTypeKeywordTypeGroup>();

    private List<KeyType> AvailableKeywords = new List<KeyType>();

    private List<GroupOption> GroupOptions = new List<GroupOption>();

    private bool IsBusy;

    private string? StatusMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        var documentType = await Db.DocumentTypes
            .AsNoTracking()
            .Include(documentType =>
                documentType.ItemTypeGroup)
            .SingleOrDefaultAsync(documentType =>
                documentType.ItemTypeNum == ItemTypeNum);

        if (documentType is null)
        {
            ShowError("The Document Type does not exist.");
            return;
        }

        CurrentDocumentType = documentType;

        DirectAssignments = await Db.DocumentTypeKeyTypes
            .AsNoTracking()
            .Include(assignment => assignment.KeyType)
            .Where(assignment =>
                assignment.ItemTypeNum == ItemTypeNum)
            .OrderBy(assignment =>
                assignment.DisplayOrder)
            .ThenBy(assignment =>
                assignment.KeyType.KeyTypeName)
            .ToListAsync();

        GroupAssignments =
            await Db.DocumentTypeKeywordTypeGroups
                .AsNoTracking()
                .Include(assignment =>
                    assignment.KeywordTypeGroup)
                .ThenInclude(group =>
                    group.KeywordTypeMemberships)
                .ThenInclude(membership =>
                    membership.KeyType)
                .Where(assignment =>
                    assignment.ItemTypeNum == ItemTypeNum)
                .OrderBy(assignment =>
                    assignment.DisplayOrder)
                .ThenBy(assignment =>
                    assignment.KeywordTypeGroup.KeySetName)
                .ToListAsync();

        var effectiveKeywordNumbers =
            GetEffectiveKeywordNumbers();

        AvailableKeywords = await Db.KeyTypes
            .AsNoTracking()
            .Where(keyword =>
                !effectiveKeywordNumbers.Contains(
                    keyword.KeyTypeNum))
            .OrderBy(keyword =>
                keyword.KeyTypeName)
            .ToListAsync();

        var assignedGroupNumbers = GroupAssignments
            .Select(assignment =>
                assignment.KeySetTableNum)
            .ToHashSet();

        var unassignedGroups = await Db.KeywordSets
            .AsNoTracking()
            .Where(group =>
                group.IsKeyTypeGroup == 1 &&
                !assignedGroupNumbers.Contains(
                    group.KeySetTableNum))
            .Include(group =>
                group.KeywordTypeMemberships)
            .ThenInclude(membership =>
                membership.KeyType)
            .OrderBy(group =>
                group.KeySetName)
            .ToListAsync();

        GroupOptions = unassignedGroups
            .Select(group =>
            {
                var conflicts = group.KeywordTypeMemberships
                    .Where(membership =>
                        effectiveKeywordNumbers.Contains(
                            membership.KeyTypeNum))
                    .Select(membership =>
                        membership.KeyType.KeyTypeName)
                    .Distinct()
                    .OrderBy(name => name)
                    .ToList();

                return new GroupOption
                {
                    Group = group,
                    IsEmpty =
                        group.KeywordTypeMemberships.Count == 0,
                    ConflictingKeywords = conflicts
                };
            })
            .ToList();
    }

    private HashSet<long> GetEffectiveKeywordNumbers()
    {
        var effectiveKeywordNumbers = DirectAssignments
            .Select(assignment =>
                assignment.KeyTypeNum)
            .ToHashSet();

        foreach (var groupAssignment in GroupAssignments)
        {
            foreach (var membership in
                groupAssignment.KeywordTypeGroup
                    .KeywordTypeMemberships)
            {
                effectiveKeywordNumbers.Add(
                    membership.KeyTypeNum);
            }
        }

        return effectiveKeywordNumbers;
    }

    private async Task AddKeywordAsync(long keyTypeNum)
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        IsBusy = true;

        try
        {
            var keyword = await Db.KeyTypes
                .AsNoTracking()
                .SingleOrDefaultAsync(item =>
                    item.KeyTypeNum == keyTypeNum);

            if (keyword is null)
            {
                ShowError("The Keyword Type no longer exists.");
                return;
            }

            var directlyAssigned =
                await Db.DocumentTypeKeyTypes
                    .AsNoTracking()
                    .AnyAsync(assignment =>
                        assignment.ItemTypeNum == ItemTypeNum &&
                        assignment.KeyTypeNum == keyTypeNum);

            if (directlyAssigned)
            {
                ShowError(
                    $"“{keyword.KeyTypeName}” is already directly assigned.");

                return;
            }

            var assignedGroupNumbers =
                await Db.DocumentTypeKeywordTypeGroups
                    .AsNoTracking()
                    .Where(assignment =>
                        assignment.ItemTypeNum == ItemTypeNum)
                    .Select(assignment =>
                        assignment.KeySetTableNum)
                    .ToListAsync();

            var blockingGroups = await Db.KeywordSetKeyTypes
                .AsNoTracking()
                .Where(membership =>
                    membership.KeyTypeNum == keyTypeNum &&
                    assignedGroupNumbers.Contains(
                        membership.KeySetTableNum))
                .Select(membership =>
                    membership.KeywordSet.KeySetName)
                .Distinct()
                .OrderBy(name => name)
                .ToListAsync();

            if (blockingGroups.Count > 0)
            {
                ShowError(
                    $"“{keyword.KeyTypeName}” cannot be added directly " +
                    $"because it is already supplied by: " +
                    $"{string.Join(", ", blockingGroups)}.");

                return;
            }

            var maximumOrder = await Db.DocumentTypeKeyTypes
                .Where(assignment =>
                    assignment.ItemTypeNum == ItemTypeNum)
                .MaxAsync(assignment =>
                    (int?)assignment.DisplayOrder);

            Db.DocumentTypeKeyTypes.Add(
                new DocumentTypeKeyType
                {
                    ItemTypeNum = ItemTypeNum,
                    KeyTypeNum = keyTypeNum,
                    DisplayOrder =
                        (maximumOrder ?? 0) + 1
                });

            await Db.SaveChangesAsync();

            Db.ChangeTracker.Clear();

            await LoadPageAsync();
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                "The Keyword Type could not be added because it is already assigned.");
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Keyword Type could not be added: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task AddGroupAsync(long keySetTableNum)
    {
        StatusMessage = null;

        if (IsBusy)
        {
            return;
        }

        IsBusy = true;

        try
        {
            var group = await Db.KeywordSets
                .AsNoTracking()
                .Where(item =>
                    item.KeySetTableNum == keySetTableNum &&
                    item.IsKeyTypeGroup == 1)
                .Include(item =>
                    item.KeywordTypeMemberships)
                .ThenInclude(membership =>
                    membership.KeyType)
                .SingleOrDefaultAsync();

            if (group is null)
            {
                ShowError(
                    "The standard Keyword Type Group no longer exists.");

                return;
            }

            if (group.KeywordTypeMemberships.Count == 0)
            {
                ShowError(
                    $"“{group.KeySetName}” contains no Keyword Types.");

                return;
            }

            var alreadyAssigned =
                await Db.DocumentTypeKeywordTypeGroups
                    .AsNoTracking()
                    .AnyAsync(assignment =>
                        assignment.ItemTypeNum == ItemTypeNum &&
                        assignment.KeySetTableNum == keySetTableNum);

            if (alreadyAssigned)
            {
                ShowError(
                    $"“{group.KeySetName}” is already assigned.");

                return;
            }

            var directKeywordNumbers =
                await Db.DocumentTypeKeyTypes
                    .AsNoTracking()
                    .Where(assignment =>
                        assignment.ItemTypeNum == ItemTypeNum)
                    .Select(assignment =>
                        assignment.KeyTypeNum)
                    .ToListAsync();

            var otherAssignedGroupNumbers =
                await Db.DocumentTypeKeywordTypeGroups
                    .AsNoTracking()
                    .Where(assignment =>
                        assignment.ItemTypeNum == ItemTypeNum)
                    .Select(assignment =>
                        assignment.KeySetTableNum)
                    .ToListAsync();

            var groupKeywordNumbers =
                await Db.KeywordSetKeyTypes
                    .AsNoTracking()
                    .Where(membership =>
                        otherAssignedGroupNumbers.Contains(
                            membership.KeySetTableNum))
                    .Select(membership =>
                        membership.KeyTypeNum)
                    .Distinct()
                    .ToListAsync();

            var effectiveKeywordNumbers =
                directKeywordNumbers
                    .Concat(groupKeywordNumbers)
                    .ToHashSet();

            var conflictingKeywords =
                group.KeywordTypeMemberships
                    .Where(membership =>
                        effectiveKeywordNumbers.Contains(
                            membership.KeyTypeNum))
                    .Select(membership =>
                        membership.KeyType.KeyTypeName)
                    .Distinct()
                    .OrderBy(name => name)
                    .ToList();

            if (conflictingKeywords.Count > 0)
            {
                ShowError(
                    $"“{group.KeySetName}” cannot be added because " +
                    $"the following Keyword Type(s) are already on " +
                    $"the Document Type: " +
                    $"{string.Join(", ", conflictingKeywords)}.");

                return;
            }

            var maximumOrder =
                await Db.DocumentTypeKeywordTypeGroups
                    .Where(assignment =>
                        assignment.ItemTypeNum == ItemTypeNum)
                    .MaxAsync(assignment =>
                        (int?)assignment.DisplayOrder);

            Db.DocumentTypeKeywordTypeGroups.Add(
                new DocumentTypeKeywordTypeGroup
                {
                    ItemTypeNum = ItemTypeNum,
                    KeySetTableNum = keySetTableNum,
                    DisplayOrder =
                        (maximumOrder ?? 0) + 1
                });

            await Db.SaveChangesAsync();

            Db.ChangeTracker.Clear();

            await LoadPageAsync();
        }
        catch (DbUpdateException)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                "The Keyword Type Group could not be added.");
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();

            ShowError(
                $"The Keyword Type Group could not be added: {ex.Message}");
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task RemoveKeywordAsync(long keyTypeNum)
    {
        StatusMessage = null;

        var assignment =
            await Db.DocumentTypeKeyTypes
                .SingleOrDefaultAsync(item =>
                    item.ItemTypeNum == ItemTypeNum &&
                    item.KeyTypeNum == keyTypeNum);

        if (assignment is null)
        {
            ShowError(
                "The direct Keyword Type assignment no longer exists.");

            return;
        }

        Db.DocumentTypeKeyTypes.Remove(assignment);

        await Db.SaveChangesAsync();

        Db.ChangeTracker.Clear();

        await LoadPageAsync();
    }

    private async Task RemoveGroupAsync(long keySetTableNum)
    {
        StatusMessage = null;

        var assignment =
            await Db.DocumentTypeKeywordTypeGroups
                .SingleOrDefaultAsync(item =>
                    item.ItemTypeNum == ItemTypeNum &&
                    item.KeySetTableNum == keySetTableNum);

        if (assignment is null)
        {
            ShowError(
                "The Keyword Type Group assignment no longer exists.");

            return;
        }

        Db.DocumentTypeKeywordTypeGroups.Remove(assignment);

        await Db.SaveChangesAsync();

        Db.ChangeTracker.Clear();

        await LoadPageAsync();
    }

    private void ShowError(string message)
    {
        StatusMessage = message;
    }

    private sealed class GroupOption
    {
        public KeywordSet Group { get; init; } = null!;

        public bool IsEmpty { get; init; }

        public List<string> ConflictingKeywords { get; init; } = new List<string>();
    }
}